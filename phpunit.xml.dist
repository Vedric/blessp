<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="false">

    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
            <exclude>tests/Integration/DatabaseTestCase.php</exclude>
        </testsuite>
        <testsuite name="e2e">
            <directory>tests/E2E</directory>
            <exclude>tests/E2E/ApiTestCase.php</exclude>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>.</directory>
        </include>
        <exclude>
            <directory>vendor</directory>
            <directory>tests</directory>
            <directory>mailer</directory>
            <directory>admin</directory>
            <directory>css</directory>
            <directory>js</directory>
            <directory>img</directory>
            <directory>video</directory>
            <directory>profile</directory>
        </exclude>
    </source>

    <php>
        <env name="DB_DSN" value="pgsql:host=127.0.0.1;port=5432;dbname=blessp_test"/>
        <env name="DB_USER" value="postgres"/>
        <env name="DB_PASS" value="postgres"/>
    </php>
</phpunit>
