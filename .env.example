# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blessp?schema=public

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT (RS256 asymmetric keys, base64-encoded PEM format)
# Generate a keypair: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM -out private.pem
# Extract public key: openssl pkey -in private.pem -pubout -out public.pem
# Base64 encode: cat private.pem | base64 -w0
JWT_PRIVATE_KEY_BASE64=<base64-encoded-RSA-private-key-PEM>
JWT_PUBLIC_KEY_BASE64=<base64-encoded-RSA-public-key-PEM>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# Service info
SERVICE_NAME=blessp-api
SERVICE_VERSION=3.0.0

# OpenTelemetry (distributed tracing)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
