# Docker Compose (used by docker-compose.yml and docker-compose.dev.yml)
POSTGRES_USER=blessp
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DB=blessp

# Database
DATABASE_URL=postgresql://blessp:<same-password-as-above>@localhost:5433/blessp?schema=public

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT (RS256 asymmetric keys, base64-encoded PEM format)
# Generate a keypair: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM -out private.pem
# Extract public key: openssl pkey -in private.pem -pubout -out public.pem
# Base64 encode: cat private.pem | base64 -w0
JWT_PRIVATE_KEY_BASE64=<base64-encoded-RSA-private-key-PEM>
JWT_PUBLIC_KEY_BASE64=<base64-encoded-RSA-public-key-PEM>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Persistent independent key: openssl rand -base64 32 (mandatory in production).
# MFA_ENCRYPTION_KEY=<32-random-bytes-base64>
# METRICS_TOKEN=<random-token-at-least-32-characters>
# Trust only the actual reverse proxy IP/CIDR, never an unrestricted hop count.
TRUST_PROXY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public base URL of the storefront, used to build links in transactional email
CLIENT_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_changeme
STRIPE_WEBHOOK_SECRET=whsec_changeme
# PayPal is a separate provider for Canadian merchants. Enable all three together.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox

# Client build-time variables (inlined into the client bundle by Vite when the
# Docker image is built; public client-side values, not secrets)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_changeme
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=

# OAuth (server-side token verification). These validate the audience of the
# tokens social sign-in returns and must match the VITE_*_CLIENT_ID values
# above. Leave unset to disable the corresponding provider.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Transactional email (required in production: EMAIL_FROM plus at least one
# provider API key)
EMAIL_FROM=orders@example.com
RESEND_API_KEY=<resend-api-key>
# POSTMARK_API_KEY=<postmark-api-key>
# POSTMARK_STREAM=outbound

# Admin account seeding (required when running the seed in production;
# password must be at least 16 characters)
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-password-of-16-chars-or-more>

# Redis (optional, app works without it in no-op mode)
REDIS_URL=redis://localhost:6379

# Service info
SERVICE_NAME=blessp-api
SERVICE_VERSION=3.0.0

# OpenTelemetry (distributed tracing)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Production requires a real support mailbox and explicitly approved shipping rates.
# SUPPORT_EMAIL=support@your-domain.tld
# Example syntax only; these are NOT approved commercial prices.
# SHIPPING_RATES_JSON=[{"country":"CA","feeCents":995,"freeThresholdCents":10000}]
# freeThresholdCents: null disables the free-shipping threshold for that country.
