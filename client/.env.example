# Stripe publishable key (client-side). Must match the server's STRIPE_SECRET_KEY
# environment (same test/live mode). Without this value the checkout UI will
# disable payments and log a warning on production builds.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_changeme

# Google Sign-In OAuth 2.0 client id (Web application type). Leave unset to
# hide the Google button at runtime.
VITE_GOOGLE_CLIENT_ID=

# Apple Sign-In Services id. Leave unset to hide the Apple button.
VITE_APPLE_CLIENT_ID=

# Optional: override the default API base. Defaults to same-origin in prod
# and http://localhost:3000 in dev.
# VITE_API_BASE_URL=http://localhost:3000

# Confirmed brand profiles only. Blank values hide the social links.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_FACEBOOK_URL=
