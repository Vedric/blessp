{
  "name": "blessp",
  "version": "3.0.0",
  "private": true,
  "description": "Blessp e-commerce platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "test": "cd server && npm test",
    "test:integration": "cd server && npm run test:integration",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "cd server && npm run lint",
    "lint:client": "cd client && npm run lint",
    "db:migrate": "cd server && npx prisma migrate deploy",
    "db:seed": "cd server && npx prisma db seed",
    "db:studio": "cd server && npx prisma studio",
    "build:test": "node scripts/build-e2e.cjs",
    "check:launch": "node scripts/check-launch.cjs",
    "catalogue:check": "node scripts/check-catalogue.cjs",
    "test:scripts": "node --test scripts/tests/*.test.cjs",
    "test:load": "node scripts/load-commerce.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "lighthouse": "13.4.1"
  }
}
